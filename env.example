# ─── Agentic Log Pipeline — Environment Config ───────────────────────────────
# Copy to .env and adjust for your deployment.
# For local Docker Compose, defaults work out of the box.

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
COLLECTION_NAME=logs_collection

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_MODEL=mistral
# Alternatives: llama3, phi3, gemma2

# ── n8n ───────────────────────────────────────────────────────────────────────
N8N_HOST=n8n
N8N_PORT=5678
N8N_WEBHOOK_PATH=log-event

# ── NiFi ──────────────────────────────────────────────────────────────────────
NIFI_HOST=nifi
NIFI_PORT=8080
NIFI_USER=admin
NIFI_PASS=admin12345678

# ── Agents API ────────────────────────────────────────────────────────────────
AGENTS_HOST=agents
AGENTS_PORT=8000

# ── Dashboard ─────────────────────────────────────────────────────────────────
DASHBOARD_PORT=8501
